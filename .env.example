# Phase 0 does not require a running Postgres for tests: the suite uses PGlite,
# an in-process build of Postgres, so `npm test` works with no services.
#
# For a real deployment, point this at a Postgres 16 or newer instance in a
# Canadian region (see architecture.md section 15 on residency).
DATABASE_URL=postgres://searchical_app:change_me@localhost:5432/searchical

# The role the application connects as. It is deliberately NOT the owner of the
# tables and it has no UPDATE or DELETE on any append only table. See
# migrations/0002_security.sql.
DATABASE_APP_ROLE=searchical_app

LOG_LEVEL=info
NODE_ENV=development
